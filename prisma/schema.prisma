// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model QuizAttempt {
  id        String   @id @default(cuid())
  userId    String
  lesson    Int
  category  String
  total     Int
  correct   Int
  percent   Float
  score     Int? // only the 60s rush challenge stores its points here
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([category, createdAt])
}

model LearnerProfile {
  userId    String   @id
  name      String
  color     String   @default("emerald")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// F3 «کد یادگیرنده» — cloud sync of learner progress across devices.
// The 8-char code acts as a lightweight credential (no auth); lookups
// are rate-limited on the API layer against brute force.
model LearnerSync {
  code      String   @id
  userId    String
  data      String // JSON snapshot (same shape as BackupPayload.data)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
}

// F8 «چرا غلط شد؟» — server-side cache of AI explanations, keyed by
// question id. Every learner asking about the same question gets the
// exact same controlled answer (one generation, many reads).
model ExplainCache {
  key         String   @id
  explanation String
  source      String   @default("ai") // "ai" | "fallback"
  createdAt   DateTime @default(now())
}

// F10 lightweight product analytics — no PII, no user identifiers.
// Only aggregate counters per UTC day per whitelisted event name.
model EventDay {
  id    String @id @default(cuid())
  day   String // YYYY-MM-DD (UTC)
  name  String
  count Int    @default(0)

  @@unique([day, name])
  @@index([name])
}
