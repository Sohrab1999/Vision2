// Prisma schema — RECONSTRUCTED in r456 after the environment reset
// restored an ancient (pre-r250) schema file. Every model below was
// rebuilt from its usage sites in src/ (routes/lib) and the route-level
// test contracts; the seven pre-existing models keep their historical
// comments and columns verbatim, renamed to the camelCase convention the
// whole codebase uses (db.learnerProfile / db.quizAttempt / ...).
// The three AI caches (reviewCache / storyCache / weekReviewCache) are
// the store-once-serve-forever tables of Tasks 116/117/119.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model quizAttempt {
  id        String   @id @default(cuid())
  userId    String
  lesson    Int
  category  String
  total     Int
  correct   Int
  percent   Float
  score     Int? // only the 60s rush challenge and 2-player duels store their points here
  // Task-36 «جدول نبرد»: duel rows only — server-accepted outcome reported
  // by each signed player ("win" | "loss" | "tie"). Null for every other
  // category (and legacy duel rows from before this field existed).
  outcome   String?
  // Task 94 «رسیدِ امضاشدهٔ داوری»: HMAC sig hex from the :3003 judge — the
  // only way a NEW duel row enters /api/stats. Null for every other category
  // and for legacy duel rows. Uniqueness per (userId, sig) is enforced in the
  // route (replay check) — one receipt, one row per player, never farmable.
  receiptSig String?
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([category, createdAt])
  // live recent-attempts feed (orderBy createdAt desc, take 10) + 24h count
  // range in /api/stats — both scan/sort the whole table without this index
  @@index([createdAt])
}

model learnerProfile {
  userId    String   @id
  name      String
  color     String   @default("emerald")
  // Phase-0 «اعتماد»: server-issued write secret. Issued once via
  // /api/register (first-claim wins); every stats/profile write must
  // present it. Nullable only for legacy rows created before launch —
  // they get claimed on the learner's next app load.
  secret    String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// F3 «کد یادگیرنده» — cloud sync of learner progress across devices.
// The 8-char code acts as a lightweight credential (no auth); lookups
// are rate-limited on the API layer against brute force.
model learnerSync {
  code      String   @id
  userId    String
  data      String // JSON snapshot (same shape as BackupPayload.data)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
}

// F8 «چرا غلط شد؟» — server-side cache of AI explanations, keyed by
// question id. Every learner asking about the same question gets the
// exact same controlled answer (one generation, many reads).
model explainCache {
  key         String   @id
  explanation String
  source      String   @default("ai") // "ai" | "fallback"
  createdAt   DateTime @default(now())
}

// Task 116 «داستانِ واژه‌ها» — server-side cache of AI stories, keyed by
// the fingerprint of the (sorted) word-key set. One generation, many reads.
model storyCache {
  key       String   @id
  story     String
  summary   String
  source    String   @default("ai") // "ai" | "fallback"
  createdAt DateTime @default(now())
}

// Task 117 «معلمِ کارنامه» — server-side cache of AI session reviews,
// keyed by the session fingerprint (ids + answers are order-insensitive).
model reviewCache {
  key      String   @id
  intro    String
  strength String
  advice   String
  source   String   @default("ai") // "ai" | "fallback"
  createdAt DateTime @default(now())
}

// Task 119 «معلمِ هفته» — server-side cache of AI weekly verdicts, keyed
// by the week fingerprint. Same store-once economy as its two siblings.
model weekReviewCache {
  key      String   @id
  intro    String
  strength String
  advice   String
  source   String   @default("ai") // "ai" | "fallback"
  createdAt DateTime @default(now())
}

// F10 lightweight product analytics — no PII, no user identifiers.
// Only aggregate counters per UTC day per whitelisted event name.
model eventDay {
  id    String @id @default(cuid())
  day   String // YYYY-MM-DD (UTC)
  name  String
  count Int    @default(0)

  @@unique([day, name])
  @@index([name])
}

// r347 «سقفِ ماهانهٔ روخوانی» — per-UTC-day character meter for the paid
// TTS backend. Only cache misses (real paid syntheses) increment; the
// month-to-date sum gates POST /api/tts with an honest 429 and feeds
// GET /api/tts/usage (the settings budget row). Metering is a cost guard,
// not correctness: every meter failure fails OPEN (TTS stays available).
model ttsMeter {
  day   String @id // YYYY-MM-DD (UTC)
  chars Int    @default(0)
}

// r348 «سقفِ ماهانهٔ توضیحِ هوشمند» — per-UTC-day generation meter for the
// paid AI explain endpoint (same cost family as ttsMeter). Only REAL ai
// generations increment (+1 each); cached reads and SDK-down fallback text
// are free and unmetered. Fails OPEN exactly like its sibling.
model explainMeter {
  day  String @id // YYYY-MM-DD (UTC)
  gens Int    @default(0)
}
