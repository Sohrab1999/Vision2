// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model QuizAttempt {
  id        String   @id @default(cuid())
  userId    String
  lesson    Int
  category  String
  total     Int
  correct   Int
  percent   Float
  score     Int? // only the 60s rush challenge and 2-player duels store their points here
  // Task-36 «جدول نبرد»: duel rows only — server-accepted outcome reported
  // by each signed player ("win" | "loss" | "tie"). Null for every other
  // category (and legacy duel rows from before this field existed).
  outcome   String?
  // Task 94 «رسیدِ امضاشدهٔ داوری»: HMAC sig hex from the :3003 judge — the
  // only way a NEW duel row enters /api/stats. Null for every other category
  // and for legacy duel rows. Uniqueness per (userId, sig) is enforced in the
  // route (replay check) — one receipt, one row per player, never farmable.
  receiptSig String?
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([category, createdAt])
  // live recent-attempts feed (orderBy createdAt desc, take 10) + 24h count
  // range in /api/stats — both scan/sort the whole table without this index
  @@index([createdAt])
}

model LearnerProfile {
  userId    String   @id
  name      String
  color     String   @default("emerald")
  // Phase-0 «اعتماد»: server-issued write secret. Issued once via
  // /api/register (first-claim wins); every stats/profile write must
  // present it. Nullable only for legacy rows created before launch —
  // they get claimed on the learner's next app load.
  secret    String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// F3 «کد یادگیرنده» — cloud sync of learner progress across devices.
// The 8-char code acts as a lightweight credential (no auth); lookups
// are rate-limited on the API layer against brute force.
model LearnerSync {
  code      String   @id
  userId    String
  data      String // JSON snapshot (same shape as BackupPayload.data)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
}

// F8 «چرا غلط شد؟» — server-side cache of AI explanations, keyed by
// question id. Every learner asking about the same question gets the
// exact same controlled answer (one generation, many reads).
model ExplainCache {
  key         String   @id
  explanation String
  source      String   @default("ai") // "ai" | "fallback"
  createdAt   DateTime @default(now())
}

// F10 lightweight product analytics — no PII, no user identifiers.
// Only aggregate counters per UTC day per whitelisted event name.
model EventDay {
  id    String @id @default(cuid())
  day   String // YYYY-MM-DD (UTC)
  name  String
  count Int    @default(0)

  @@unique([day, name])
  @@index([name])
}
