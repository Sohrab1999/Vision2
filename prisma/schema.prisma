// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model QuizAttempt {
  id        String   @id @default(cuid())
  userId    String
  lesson    Int
  category  String
  total     Int
  correct   Int
  percent   Float
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([createdAt])
}
