    },
    {
      "page": "/api/event",
      "regex": "^/api/event(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/api/event(?:/)?$"
    },
    {
      "page": "/api/explain",
      "regex": "^/api/explain(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/api/explain(?:/)?$"
    },
    {
      "page": "/api/explain/usage",
      "regex": "^/api/explain/usage(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/api/explain/usage(?:/)?$"
    },
    {
      "page": "/api/leaderboard",
      "regex": "^/api/leaderboard(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/api/leaderboard(?:/)?$"
    },
    {
      "page": "/api/profile",
      "regex": "^/api/profile(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/api/profile(?:/)?$"
    },
    {
      "page": "/api/register",
      "regex": "^/api/register(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/api/register(?:/)?$"
    },
    {
      "page": "/api/rush-leaderboard",
      "regex": "^/api/rush\\-leaderboard(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/api/rush\\-leaderboard(?:/)?$"
    },
    {
      "page": "/api/stats",
      "regex": "^/api/stats(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/api/stats(?:/)?$"
    },
    {
      "page": "/api/sync",
      "regex": "^/api/sync(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/api/sync(?:/)?$"
    },
    {
      "page": "/api/teacher/learner",
      "regex": "^/api/teacher/learner(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/api/teacher/learner(?:/)?$"
    },
    {
      "page": "/api/teacher/report",
      "regex": "^/api/teacher/report(?:/)?$",
      "routeKeys": {},
